{
  "compilerOptions": {
    "target": "ES2020",       
    "module": "commonjs",              
    "lib": ["es2020"],                  
    "allowJs": true,
    "outDir": "dist",                 
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
